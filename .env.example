# MailScout Environment Variables
# PUBLIC - This file is a template. 
# Copy this to .env.local for local development.

# Groq API Key (Get one at console.groq.com)
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# Optional: Personal Gmail for easier use
# If set, you won't need to enter these in the UI every time
GMAIL_USER=YOUR_GMAIL@GMAIL.COM
GMAIL_PASS=YOUR_GMAIL_APP_PASSWORD_HERE
